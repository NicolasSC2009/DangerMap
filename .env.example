# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O arquivo ".env" NUNCA deve ser enviado/commitado: ele guarda senhas e chaves.

# Banco de dados (PostGIS, sobe pelo Docker)
DB_USER=admin
DB_PASSWORD=troque-esta-senha
DB_NAME=dangermap_db
DATABASE_URL="postgresql://admin:troque-esta-senha@127.0.0.1:5432/dangermap_db?schema=public"

# pgAdmin (opcional, painel web do banco em http://localhost:8080)
PGADMIN_EMAIL=voce@example.com
PGADMIN_PASSWORD=troque-esta-senha

NODE_ENV=development

# Login: gere dois textos aleatorios diferentes e longos
JWT_SECRET=troque-por-um-texto-aleatorio-longo
REFRESH_SECRET=troque-por-outro-texto-aleatorio-longo

# reCAPTCHA (deixe em branco para desativar fora de producao)
RECAPTCHA_SECRET_KEY=
# reCAPTCHA v3: nota minima para aceitar (0 a 1). Padrao 0.5.
RECAPTCHA_SCORE_MINIMO=0.5

# E-mail de recuperacao de senha. Se SMTP_HOST ficar vazio, o sistema usa uma
# conta de teste (o e-mail nao chega de verdade).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Chave do Gemini (sugestao de categoria pela foto). Sem ela a sugestao por foto fica desligada.
GEMINI_API_KEY=
