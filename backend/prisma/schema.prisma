generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum TipoUsuario {
  usuario
  admin
}

enum TipoProblema {
  alagamento
  buraco
  seguranca
  transito
  arvore_caida
  roubo
  batida_de_carro
  carro_no_acostamento
  incendio
  placa_danificada
  obras_na_pista
  via_interditada
  perigo_na_pista
  outros
}

enum StatusOcorrencia {
  pendente
  confirmado
  resolvido
}

enum Gravidade {
  baixo
  medio
  alto
}

// --- TABELAS ---

model Usuario {
  id            Int           @id @default(autoincrement())
  nome          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(100)
  senha         String        @db.VarChar(255)
  tipo_usuario  TipoUsuario   @default(usuario)
  data_cadastro DateTime      @default(now())
  verificado    Boolean       @default(false)

  // Relações
  ocorrencias       Ocorrencia[]
  confirmacoes      Confirmacao[]
  denuncias         Denuncia[]
  notificacoes      Notificacao[]
  interacoes        InteracaoSocial[]
  logs_sos          LogSOS[]
  denuncias_feitas  DenunciaUsuario[] @relation("AutorDenuncia")
  denuncias_recebidas DenunciaUsuario[] @relation("UsuarioDenunciado")
  logs_atividades   LogAtividade[]

  @@map("usuarios")
}

model Ocorrencia {
  id                    Int              @id @default(autoincrement())
  usuario_id            Int?
  usuario               Usuario?         @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  tipo_problema         TipoProblema
  gravidade             Gravidade        @default(medio)
  descricao             String?          @db.Text
  latitude              Decimal          @db.Decimal(10, 8)
  longitude             Decimal          @db.Decimal(11, 8)
  status                StatusOcorrencia @default(pendente)
  data_registro         DateTime         @default(now())
  qtd_confirmacoes      Int              @default(0)
  imagem_url            String?          @db.VarChar(255)
  categoria_sugerida_ia String?          @db.VarChar(100)
  id_agrupamento        Int?

  confirmacoes          Confirmacao[]
  denuncias             Denuncia[]
  interacoes            InteracaoSocial[]

  @@map("ocorrencias")
}

model Confirmacao {
  id               Int        @id @default(autoincrement())
  usuario_id       Int
  usuario          Usuario    @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  ocorrencia_id    Int
  ocorrencia       Ocorrencia @relation(fields: [ocorrencia_id], references: [id], onDelete: Cascade)
  data_confirmacao DateTime   @default(now())

  @@unique([usuario_id, ocorrencia_id])
  @@map("confirmacoes")
}

model Denuncia {
  id            Int        @id @default(autoincrement())
  usuario_id    Int
  usuario       Usuario    @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  ocorrencia_id Int
  ocorrencia    Ocorrencia @relation(fields: [ocorrencia_id], references: [id], onDelete: Cascade)
  motivo        String     @db.Text
  data_denuncia DateTime   @default(now())

  @@map("denuncias")
}

model Notificacao {
  id               Int      @id @default(autoincrement())
  usuario_id       Int
  usuario          Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  titulo           String   @db.VarChar(150)
  mensagem         String   @db.Text
  tipo_notificacao String?  @db.VarChar(50)
  lida             Boolean  @default(false)
  data_envio       DateTime @default(now())

  @@map("notificacoes")
}

model InteracaoSocial {
  id             Int        @id @default(autoincrement())
  ocorrencia_id  Int
  ocorrencia     Ocorrencia @relation(fields: [ocorrencia_id], references: [id], onDelete: Cascade)
  usuario_id     Int
  usuario        Usuario    @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  tipo_interacao String?    @db.VarChar(20)
  data_interacao DateTime   @default(now())

  @@map("interacoes_sociais")
}

model LogSOS {
  id               Int      @id @default(autoincrement())
  usuario_id       Int?
  usuario          Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  data_hora        DateTime @default(now())
  orgao_contactado String?  @db.VarChar(50)

  @@map("logs_sos")
}

model DadoClimatico {
  id              Int      @id @default(autoincrement())
  regiao          String?  @db.VarChar(100)
  temperatura     Decimal? @db.Decimal(4, 2)
  condicao_tempo  String?  @db.VarChar(100)
  data_leitura    DateTime @default(now())

  @@map("dados_climaticos")
}

model DenunciaUsuario {
  id                     Int      @id @default(autoincrement())
  usuario_denunciado_id  Int
  usuario_denunciado     Usuario  @relation("UsuarioDenunciado", fields: [usuario_denunciado_id], references: [id], onDelete: Cascade)
  autor_id               Int
  autor                  Usuario  @relation("AutorDenuncia", fields: [autor_id], references: [id], onDelete: Cascade)
  motivo                 String?  @db.Text
  ip_origem              String?  @db.VarChar(45)
  data_hora              DateTime @default(now())

  @@map("denuncias_usuarios")
}

model LogAtividade {
  id         Int      @id @default(autoincrement())
  usuario_id Int?
  usuario    Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  acao       String   @db.VarChar(255)
  ip_origem  String?  @db.VarChar(45)
  user_agent String?  @db.Text
  data_hora  DateTime @default(now())

  @@map("logs_atividades")
}